{
  "$schema": "https://lotioncode.ai/theme.json",
  "name": "high-contrast",
  "description": "Maximum contrast for accessibility",
  "defs": {
    "black": "#000000",
    "white": "#FFFFFF",
    "gray": "#808080",
    "darkGray": "#404040",
    "lightGray": "#C0C0C0",
    "blue": "#0066FF",
    "green": "#00CC00",
    "red": "#FF0000",
    "yellow": "#FFCC00",
    "cyan": "#00CCCC",
    "magenta": "#CC00CC"
  },
  "theme": {
    "primary": "blue",
    "secondary": "cyan",
    "accent": "magenta",
    "error": "red",
    "warning": "yellow",
    "success": "green",
    "info": "cyan",
    "text": "white",
    "textMuted": "lightGray",
    "background": "black",
    "backgroundPanel": "darkGray",
    "backgroundElement": "gray",
    "border": "white",
    "borderActive": "blue",
    "borderSubtle": "lightGray",
    "diffAdded": "green",
    "diffRemoved": "red",
    "diffContext": "gray",
    "diffHunkHeader": "lightGray",
    "diffHighlightAdded": "green",
    "diffHighlightRemoved": "red",
    "diffAddedBg": "#003300",
    "diffRemovedBg": "#330000",
    "diffContextBg": "darkGray",
    "diffLineNumber": "gray",
    "diffAddedLineNumberBg": "#001a00",
    "diffRemovedLineNumberBg": "#1a0000",
    "markdownText": "white",
    "markdownHeading": "blue",
    "markdownLink": "cyan",
    "markdownLinkText": "blue",
    "markdownCode": "magenta",
    "markdownBlockQuote": "green",
    "markdownEmph": "yellow",
    "markdownStrong": "blue",
    "markdownHorizontalRule": "gray",
    "markdownListItem": "blue",
    "markdownListEnumeration": "yellow",
    "markdownImage": "cyan",
    "markdownImageText": "blue",
    "markdownCodeBlock": "white",
    "syntaxComment": "gray",
    "syntaxKeyword": "magenta",
    "syntaxFunction": "blue",
    "syntaxVariable": "white",
    "syntaxString": "green",
    "syntaxNumber": "cyan",
    "syntaxType": "yellow",
    "syntaxOperator": "red",
    "syntaxPunctuation": "lightGray"
  }
}
